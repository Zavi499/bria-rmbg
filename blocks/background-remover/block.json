{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "wp-bg-remover/background-remover",
  "title": "Background Remover",
  "category": "media",
  "icon": "format-image",
  "description": "Remove background from images using AI",
  "keywords": ["image", "background", "remove", "ai"],
  "version": "1.0.0",
  "textdomain": "wp-background-remover",
  "attributes": {
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "processedImageUrl": {
      "type": "string",
      "default": ""
    },
    "backgroundColor": {
      "type": "string",
      "default": "transparent"
    },
    "showComparison": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./style.css",
  "style": "file:./style.css"
}
